{
  "about": "r22 invite note 301 static characters plus a variable",
  "rules": [
    "R22"
  ],
  "schema_valid": true,
  "document": {
    "on_reply": "end",
    "steps": [
      {
        "id": "inv",
        "do": "invite.send",
        "with": {
          "note": "{{contact.first_name}} ",
          "note_fallback": "drop"
        },
        "next": "end"
      }
    ]
  },
  "errors": [
    {
      "path": "inv.with.note",
      "rule": "301 characters; the limit is 300, variables not counted"
    }
  ],
  "warnings": []
}
