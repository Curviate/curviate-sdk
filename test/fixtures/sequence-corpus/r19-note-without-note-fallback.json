{
  "about": "r19 note without note fallback",
  "rules": [
    "R19"
  ],
  "schema_valid": true,
  "document": {
    "on_reply": "end",
    "steps": [
      {
        "id": "inv",
        "do": "invite.send",
        "with": {
          "note": "Hi {{contact.first_name}}"
        },
        "next": "end"
      }
    ]
  },
  "errors": [
    {
      "path": "inv.with.note_fallback",
      "rule": "required because the note uses a variable: text, or \"drop\""
    }
  ],
  "warnings": []
}
