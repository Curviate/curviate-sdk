{
  "about": "valid every action",
  "rules": [],
  "schema_valid": true,
  "document": {
    "on_reply": "end",
    "steps": [
      {
        "id": "view",
        "do": "profile.view"
      },
      {
        "id": "follow",
        "do": "profile.follow",
        "with": {}
      },
      {
        "id": "unfollow",
        "do": "profile.unfollow"
      },
      {
        "id": "invite",
        "do": "invite.send",
        "with": {
          "note": "Hi {{contact.first_name}}, saw your talk.",
          "note_fallback": "drop",
          "withdraw_after": "14d"
        }
      },
      {
        "id": "invite2",
        "do": "invite.send",
        "with": {
          "note": null,
          "withdraw_after": "180d"
        }
      },
      {
        "id": "withdraw",
        "do": "invite.withdraw"
      },
      {
        "id": "dm",
        "do": "message.send",
        "with": {
          "text": "Hi {{ contact.first_name }} from {{account.full_name}}",
          "fallback": "Hi there"
        },
        "else": "inmail"
      },
      {
        "id": "inmail",
        "do": "inmail.send",
        "with": {
          "subject": "Quick question",
          "text": "Hi {{contact.extra.hook}}",
          "fallback": {
            "subject": "Quick question",
            "text": "Hi there"
          }
        }
      },
      {
        "id": "inmail2",
        "do": "inmail.send",
        "variants": [
          {
            "id": "im_a",
            "subject": "A",
            "text": "Body A"
          },
          {
            "id": "im_b",
            "subject": "B",
            "text": "Body B"
          }
        ]
      },
      {
        "id": "react",
        "do": "post.react",
        "with": {
          "post": "latest",
          "newer_than": "1h",
          "reaction": "insightful"
        }
      },
      {
        "id": "comment",
        "do": "post.comment",
        "with": {
          "post": "latest",
          "newer_than": "365d",
          "text": "{{contact.extra.comment}}",
          "fallback": "Thoughtful point on the rollout."
        }
      },
      {
        "id": "endorse",
        "do": "skill.endorse",
        "next": "end"
      }
    ]
  },
  "errors": [],
  "warnings": []
}
