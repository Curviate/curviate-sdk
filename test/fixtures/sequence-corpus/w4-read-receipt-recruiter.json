{
  "about": "w4 read receipt recruiter",
  "rules": [
    "W4"
  ],
  "only": "server",
  "context": {
    "stop_on_engagement": false,
    "account_profiles": [
      "recruiter",
      "recruiter"
    ]
  },
  "schema_valid": true,
  "document": {
    "on_reply": "end",
    "steps": [
      {
        "id": "r",
        "until": "message.read",
        "timeout": "2d",
        "then": "end",
        "else": "end"
      }
    ]
  },
  "errors": [],
  "warnings": [
    {
      "code": "W4",
      "path": "r.until",
      "rule": "every sending Account uses Recruiter, and Recruiter chats never report a message as read"
    }
  ]
}
