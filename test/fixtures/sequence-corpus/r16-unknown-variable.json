{
  "about": "r16 unknown variable",
  "rules": [
    "R16"
  ],
  "schema_valid": true,
  "document": {
    "on_reply": "end",
    "steps": [
      {
        "id": "m",
        "do": "message.send",
        "with": {
          "text": "Hi {{firstName}}",
          "fallback": "Hi"
        },
        "next": "end"
      }
    ]
  },
  "errors": [
    {
      "path": "m.with.text",
      "rule": "unknown variable {{firstName}}; use contact.<field>, contact.extra.<key>, account.first_name, account.last_name, account.full_name or motion.<key>"
    }
  ],
  "warnings": []
}
