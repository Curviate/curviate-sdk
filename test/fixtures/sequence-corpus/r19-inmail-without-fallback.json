{
  "about": "r19 inmail without fallback",
  "rules": [
    "R19"
  ],
  "schema_valid": true,
  "document": {
    "on_reply": "end",
    "steps": [
      {
        "id": "im",
        "do": "inmail.send",
        "with": {
          "subject": "Hi {{contact.first_name}}",
          "text": "Body"
        },
        "next": "end"
      }
    ]
  },
  "errors": [
    {
      "path": "im.with.fallback",
      "rule": "required because the subject or text uses a variable: an object with subject and text"
    }
  ],
  "warnings": []
}
